//MINISQL  JOB (ACCT),'MINISQL',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//*
//* Example run JCL. Adjust STEPLIB if your deployed loadlib differs.
//*
//RUN      EXEC PGM=MINISQL
//STEPLIB  DD DISP=SHR,DSN=IBMUSER.MINISQL.LOAD
//MINIKV   DD DISP=OLD,DSN=IBMUSER.MINISQL.KV
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
CREATE TABLE PEOPLE (ID INT PRIMARY KEY, NAME VARCHAR(8), CITY CHAR(8),
AGE INT, EMAIL VARCHAR(16));
.SCHEMA PEOPLE
INSERT INTO PEOPLE VALUES (1, 'ANA', 'ZAGREB', 30, 'ANA@EX');
INSERT INTO PEOPLE VALUES (2, 'IVO', 'SPLIT', 41, 'IVO@EX');
INSERT INTO PEOPLE VALUES ('ABC', 'BAD', 'ZAGREB', 20, 'BAD@EX');
INSERT INTO PEOPLE VALUES (3, 'PREDUGOIME', 'ZAGREB', 20, 'LONG@EX');
CREATE INDEX IDXCITY ON PEOPLE (CITY);
.SCHEMA PEOPLE
DESC PEOPLE
CREATE TABLE ORDERS (OID INT PRIMARY KEY, PERSON_ID INT,
ITEM VARCHAR(8), FOREIGN KEY (PERSON_ID) REFERENCES PEOPLE(ID));
.SCHEMA ORDERS
DESCRIBE ORDERS
INSERT INTO ORDERS VALUES (100, 1, 'BOOK');
INSERT INTO ORDERS VALUES (101, 99, 'BAD');
INSERT INTO ORDERS VALUES (102, 2, 'PEN');
BEGIN;
INSERT INTO PEOPLE VALUES (4, 'MIRA', 'OSIJEK', 28, 'MIRA@EX');
ROLLBACK;
SELECT * FROM PEOPLE;
SELECT COUNT(*) FROM PEOPLE;
SELECT NAME,CITY FROM PEOPLE;
SELECT * FROM PEOPLE WHERE NAME LIKE 'A%';
SELECT * FROM PEOPLE WHERE ID > 1;
SELECT * FROM PEOPLE WHERE ID BETWEEN 1 AND 2;
SELECT * FROM PEOPLE WHERE AGE > 35;
SELECT * FROM PEOPLE WHERE CITY='ZAGREB' OR CITY='SPLIT';
SELECT * FROM PEOPLE ORDER BY NAME DESC;
SELECT * FROM PEOPLE WHERE ID > 0 ORDER BY AGE DESC;
SELECT * FROM PEOPLE GROUP BY CITY;
SELECT * FROM PEOPLE GROUP BY CITY ORDER BY COUNT DESC;
CREATE INDEX IDXPID ON ORDERS (PERSON_ID);
SELECT * FROM PEOPLE JOIN ORDERS ON PEOPLE.ID=ORDERS.PERSON_ID;
UPDATE PEOPLE SET CITY='RIJEKA' WHERE ID=2;
SELECT * FROM PEOPLE;
UPDATE PEOPLE SET CITY='PULA' WHERE ID > 9 OR NAME LIKE 'NO%';
SELECT * FROM PEOPLE WHERE ID < 3 AND CITY LIKE 'RI%';
SELECT * FROM PEOPLE WHERE CITY='RIJEKA';
DELETE FROM PEOPLE WHERE ID < 2 OR NAME LIKE 'XXX%';
SELECT * FROM PEOPLE;
.QUIT
