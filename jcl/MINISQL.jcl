//MINISQL  JOB (ACCT),'MINISQL',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//*
//* Example run JCL. Adjust STEPLIB if your deployed loadlib differs.
//*
//RUN      EXEC PGM=MINISQL
//STEPLIB  DD DISP=SHR,DSN=IBMUSER.MINISQL.LOAD
//MINIKV   DD DISP=OLD,DSN=IBMUSER.MINISQL.KV
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
CREATE TABLE LJUDI (ID INT PRIMARY KEY, IME VARCHAR(8), GRAD CHAR(8));
.SCHEMA LJUDI
INSERT INTO LJUDI VALUES (1, 'ANA', 'ZAGREB');
INSERT INTO LJUDI VALUES (2, 'IVO', 'SPLIT');
INSERT INTO LJUDI VALUES ('ABC', 'BAD', 'ZAGREB');
INSERT INTO LJUDI VALUES (3, 'PREDUGOIME', 'ZAGREB');
CREATE INDEX IDXGRAD ON LJUDI (GRAD);
.SCHEMA LJUDI
SELECT * FROM LJUDI;
SELECT * FROM LJUDI WHERE IME LIKE 'A%';
SELECT * FROM LJUDI WHERE ID > 1;
SELECT * FROM LJUDI WHERE ID BETWEEN 1 AND 2;
SELECT * FROM LJUDI WHERE GRAD='ZAGREB' OR GRAD='SPLIT';
UPDATE LJUDI SET GRAD='RIJEKA' WHERE ID=2;
SELECT * FROM LJUDI;
UPDATE LJUDI SET GRAD='PULA' WHERE ID > 9 OR IME LIKE 'NO%';
SELECT * FROM LJUDI WHERE ID < 3 AND GRAD LIKE 'RI%';
SELECT * FROM LJUDI WHERE GRAD='RIJEKA';
DELETE FROM LJUDI WHERE ID < 2 OR IME LIKE 'XXX%';
SELECT * FROM LJUDI;
.QUIT
/*
