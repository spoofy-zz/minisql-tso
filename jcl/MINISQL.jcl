CREATE TABLE LJUDI (ID, IME, GRAD);
INSERT INTO LJUDI VALUES (1, 'ANA', 'ZAGREB');
INSERT INTO LJUDI VALUES (2, 'IVO', 'SPLIT');
SELECT * FROM LJUDI;
UPDATE LJUDI SET GRAD='RIJEKA' WHERE ID=2;
SELECT * FROM LJUDI;
DELETE FROM LJUDI WHERE ID=1;
SELECT * FROM LJUDI;
.QUIT
