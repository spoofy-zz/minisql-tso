//MINISQL  JOB (ACCT),'MINISQL',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//*
//* Example run JCL. Adjust STEPLIB if your deployed loadlib differs.
//*
//RUN      EXEC PGM=MINISQL
//STEPLIB  DD DISP=SHR,DSN=IBMUSER.MINISQL.LOAD
//MINIKV   DD DISP=OLD,DSN=IBMUSER.MINISQL.KV
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
CREATE TABLE PEOPLE (ID INT PRIMARY KEY, IME VARCHAR(8), GRAD CHAR(8));
.SCHEMA PEOPLE
INSERT INTO PEOPLE VALUES (1, 'ANA', 'ZAGREB');
INSERT INTO PEOPLE VALUES (2, 'IVO', 'SPLIT');
INSERT INTO PEOPLE VALUES ('ABC', 'BAD', 'ZAGREB');
INSERT INTO PEOPLE VALUES (3, 'PREDUGOIME', 'ZAGREB');
CREATE INDEX IDXGRAD ON PEOPLE (GRAD);
.SCHEMA PEOPLE
SELECT * FROM PEOPLE;
SELECT * FROM PEOPLE WHERE IME LIKE 'A%';
SELECT * FROM PEOPLE WHERE ID > 1;
SELECT * FROM PEOPLE WHERE ID BETWEEN 1 AND 2;
SELECT * FROM PEOPLE WHERE GRAD='ZAGREB' OR GRAD='SPLIT';
UPDATE PEOPLE SET GRAD='RIJEKA' WHERE ID=2;
SELECT * FROM PEOPLE;
UPDATE PEOPLE SET GRAD='PULA' WHERE ID > 9 OR IME LIKE 'NO%';
SELECT * FROM PEOPLE WHERE ID < 3 AND GRAD LIKE 'RI%';
SELECT * FROM PEOPLE WHERE GRAD='RIJEKA';
DELETE FROM PEOPLE WHERE ID < 2 OR IME LIKE 'XXX%';
SELECT * FROM PEOPLE;
.QUIT
/*
