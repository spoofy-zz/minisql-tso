//MINISQL  JOB (ACCT),'MINISQL',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//*
//* Example run JCL. Adjust STEPLIB if your deployed loadlib differs.
//*
//RUN      EXEC PGM=MINISQL
//STEPLIB  DD DISP=SHR,DSN=IBMUSER.MINISQL.LOAD
//MINIKV   DD DISP=OLD,DSN=IBMUSER.MINISQL.KV
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
CREATE TABLE PEOPLE (ID INT PRIMARY KEY, NAME VARCHAR(8), CITY CHAR(8));
.SCHEMA PEOPLE
INSERT INTO PEOPLE VALUES (1, 'ANA', 'ZAGREB');
INSERT INTO PEOPLE VALUES (2, 'IVO', 'SPLIT');
INSERT INTO PEOPLE VALUES ('ABC', 'BAD', 'ZAGREB');
INSERT INTO PEOPLE VALUES (3, 'PREDUGOIME', 'ZAGREB');
CREATE INDEX IDXCITY ON PEOPLE (CITY);
.SCHEMA PEOPLE
SELECT * FROM PEOPLE;
SELECT * FROM PEOPLE WHERE NAME LIKE 'A%';
SELECT * FROM PEOPLE WHERE ID > 1;
SELECT * FROM PEOPLE WHERE ID BETWEEN 1 AND 2;
SELECT * FROM PEOPLE WHERE CITY='ZAGREB' OR CITY='SPLIT';
UPDATE PEOPLE SET CITY='RIJEKA' WHERE ID=2;
SELECT * FROM PEOPLE;
UPDATE PEOPLE SET CITY='PULA' WHERE ID > 9 OR NAME LIKE 'NO%';
SELECT * FROM PEOPLE WHERE ID < 3 AND CITY LIKE 'RI%';
SELECT * FROM PEOPLE WHERE CITY='RIJEKA';
DELETE FROM PEOPLE WHERE ID < 2 OR NAME LIKE 'XXX%';
SELECT * FROM PEOPLE;
.QUIT
