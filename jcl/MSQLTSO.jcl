//MSQLTSO  JOB (ACCT),'MSQLTSO',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//* Reference only: MSQLTSO uses TGET and expects a foreground TSO
//* terminal. Use jcl/MINISQL.jcl for batch SQL tests.
//TSO      EXEC PGM=IKJEFT01
//STEPLIB  DD DISP=SHR,DSN=IBMUSER.MINISQL.LOAD
//MINIKV   DD DISP=OLD,DSN=IBMUSER.MINISQL.KV
//SYSPRINT DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSTSIN  DD *
CALL 'IBMUSER.MINISQL.LOAD(MSQLTSO)'
/*
